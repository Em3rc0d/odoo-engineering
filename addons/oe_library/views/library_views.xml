<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_oe_library_book_list" model="ir.ui.view">
    <field name="name">oe.library.book.list</field><field name="model">oe.library.book</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="author"/><field name="isbn"/></list></field>
  </record>
  <record id="view_oe_library_book_form" model="ir.ui.view">
    <field name="name">oe.library.book.form</field><field name="model">oe.library.book</field>
    <field name="arch" type="xml"><form string="Library Title"><sheet><group><field name="name"/><field name="author"/><field name="isbn"/><field name="active"/></group><notebook><page name="copies" string="Physical Copies"><field name="copy_ids"><list editable="bottom"><field name="code"/><field name="condition"/></list></field></page></notebook></sheet></form></field>
  </record>
  <record id="view_oe_library_copy_list" model="ir.ui.view">
    <field name="name">oe.library.copy.list</field><field name="model">oe.library.copy</field>
    <field name="arch" type="xml"><list><field name="code"/><field name="book_id"/><field name="condition"/></list></field>
  </record>
  <record id="view_oe_library_copy_form" model="ir.ui.view">
    <field name="name">oe.library.copy.form</field><field name="model">oe.library.copy</field>
    <field name="arch" type="xml"><form string="Physical Copy"><sheet><group><field name="code"/><field name="book_id"/><field name="condition"/></group></sheet></form></field>
  </record>
  <record id="view_oe_library_loan_list" model="ir.ui.view">
    <field name="name">oe.library.loan.list</field><field name="model">oe.library.loan</field>
    <field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="copy_id"/><field name="borrower_id"/><field name="loan_date"/><field name="due_date"/><field name="state"/><field name="is_overdue"/></list></field>
  </record>
  <record id="view_oe_library_loan_form" model="ir.ui.view">
    <field name="name">oe.library.loan.form</field><field name="model">oe.library.loan</field>
    <field name="arch" type="xml">
      <form string="Book Loan">
        <header>
          <button name="action_start" string="Start Loan" type="object" class="btn-primary" invisible="state != 'draft'" groups="base.group_system"/>
          <button name="action_return" string="Return Copy" type="object" class="btn-primary" invisible="state != 'active'" groups="base.group_system"/>
          <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'" groups="base.group_system"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,returned,cancelled"/>
        </header>
        <sheet><group><field name="copy_id" readonly="state != 'draft'"/><field name="borrower_id" readonly="state != 'draft'"/><field name="loan_date" readonly="state != 'draft'"/><field name="due_date" readonly="state != 'draft'"/><field name="return_date"/><field name="is_overdue"/></group></sheet>
      </form>
    </field>
  </record>
  <record id="action_oe_library_books" model="ir.actions.act_window">
    <field name="name">Titles</field><field name="res_model">oe.library.book</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_oe_library_copies" model="ir.actions.act_window">
    <field name="name">Copies</field><field name="res_model">oe.library.copy</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_oe_library_loans" model="ir.actions.act_window">
    <field name="name">Loans</field><field name="res_model">oe.library.loan</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_oe_library_root" name="Library" sequence="45" groups="base.group_user"/>
  <menuitem id="menu_oe_library_books" name="Titles" parent="menu_oe_library_root" action="action_oe_library_books" sequence="10"/>
  <menuitem id="menu_oe_library_copies" name="Copies" parent="menu_oe_library_root" action="action_oe_library_copies" sequence="20"/>
  <menuitem id="menu_oe_library_loans" name="Loans" parent="menu_oe_library_root" action="action_oe_library_loans" sequence="30"/>
</odoo>
