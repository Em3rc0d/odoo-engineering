<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="oe_workshop_quote_wizard_form" model="ir.ui.view">
    <field name="name">oe.workshop.quote.wizard.form</field><field name="model">oe.workshop.quote.wizard</field>
    <field name="arch" type="xml"><form string="Area-based quotation"><group><field name="order_id"/><field name="product_id"/><field name="width_mm"/><field name="height_mm"/><field name="pieces"/><field name="currency_id" invisible="1"/><field name="price_per_m2"/></group><footer><button name="action_add_line" type="object" string="Add line" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field>
  </record>
  <record id="oe_sale_form_inherit_quote" model="ir.ui.view">
    <field name="name">sale.order.form.oe.area.quote</field><field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_oe_open_quote_wizard" type="object" string="Custom area line" groups="sales_team.group_sale_salesman" invisible="state not in ('draft','sent')"/></xpath></field>
  </record>
</odoo>
