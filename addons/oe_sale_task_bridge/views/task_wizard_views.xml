<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_oe_task_wizard_form" model="ir.ui.view">
    <field name="name">oe.sale.task.wizard.form</field>
    <field name="model">oe.sale.task.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Project Task">
        <group>
          <field name="sale_order_id" readonly="1"/>
          <field name="project_id"/>
          <field name="name"/>
        </group>
        <footer>
          <button string="Create Task" name="action_create_task" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
