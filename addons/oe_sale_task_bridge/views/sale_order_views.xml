<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_oe_sale_order_form" model="ir.ui.view">
    <field name="name">oe.sale.order.project.tasks.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_oe_new_task" type="object" string="Create Project Task"
                invisible="state != 'sale'" groups="project.group_project_user"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_oe_view_tasks" type="object" class="oe_stat_button"
                icon="fa-tasks" groups="project.group_project_user">
          <field name="oe_task_count" widget="statinfo" string="Project Tasks"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
