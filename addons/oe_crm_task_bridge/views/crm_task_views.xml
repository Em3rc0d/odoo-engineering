<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="oe_crm_lead_form_task_inherit" model="ir.ui.view">
    <field name="name">crm.lead.form.oe.task</field><field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_oe_create_task" type="object" string="Create Project Task" groups="project.group_project_user"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button type="object" name="action_oe_open_tasks" class="oe_stat_button" icon="fa-tasks" groups="project.group_project_user">
          <field name="oe_task_count" widget="statinfo" string="Tasks"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
