<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_oe_pe_cpe_lab" model="ir.ui.view">
        <field name="name">account.move.form.oe.pe.cpe.lab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_oe_pe_lab_send" type="object"
                        string="Simular CPE (NO SUNAT)" class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or oe_pe_lab_state != 'not_submitted'"/>
                <button name="action_oe_pe_lab_check" type="object"
                        string="Consultar simulador" class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or oe_pe_lab_state != 'uncertain_simulated'"/>
            </xpath>
            <xpath expr="//form/sheet" position="inside">
                <group string="Laboratorio CPE — SIMULACIÓN LOCAL, NO SUNAT"
                       invisible="move_type != 'out_invoice'" groups="account.group_account_invoice">
                    <group>
                        <field name="oe_pe_lab_kind"/>
                        <field name="oe_pe_lab_series" placeholder="F001 o B001"/>
                        <field name="oe_pe_lab_number"/>
                        <field name="oe_pe_lab_scenario"/>
                    </group>
                    <group>
                        <field name="oe_pe_lab_state" readonly="1"/>
                        <field name="oe_pe_lab_document_ids" invisible="1"/>
                        <div class="text-danger">SIMULACIÓN LOCAL: sin envío a SUNAT, XML ni CDR real.</div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
