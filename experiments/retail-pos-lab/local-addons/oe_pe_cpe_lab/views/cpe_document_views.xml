<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_oe_pe_lab_document_list" model="ir.ui.view">
        <field name="name">oe.pe.lab.document.list</field>
        <field name="model">oe.pe.lab.document</field>
        <field name="arch" type="xml">
            <list string="CPE Local (SIMULADO)" create="0" edit="0" delete="0">
                <field name="identity_key"/>
                <field name="move_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="payload_sha256"/>
                <field name="attempt_count"/>
                <field name="last_checked_at"/>
            </list>
        </field>
    </record>
    <record id="action_oe_pe_lab_document" model="ir.actions.act_window">
        <field name="name">CPE - SIMULACIONES LOCALES</field>
        <field name="res_model">oe.pe.lab.document</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>
    <menuitem id="menu_oe_pe_lab" name="CPE SIMULADO - NO SUNAT"
              parent="account.menu_finance" action="action_oe_pe_lab_document"
              groups="account.group_account_invoice" sequence="95"/>
</odoo>
